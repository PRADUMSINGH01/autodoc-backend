{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
  },
  "include": [
    "src/**/*",
    "firebase/**/*",
    "schema/**/*",
    "routes/**/*",
    "utils/**/*",
    "queue/**/*",
    "jobs/**/*",
    "workers/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}